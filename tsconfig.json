{
  "compilerOptions": {
    "target": "ES2023", "module": "ESNext", "moduleResolution": "Bundler",
    "jsx": "react-jsx", "jsxImportSource": "preact", "allowImportingTsExtensions": true,
    "allowJs": true, "checkJs": false, "strict": true,
    "noEmit": true, "skipLibCheck": true, "types": ["node"]
  },
  "include": ["extension/**/*.ts", "collector/**/*.js", "shared/**/*.js", "capsule/**/*.ts", "capsule/**/*.tsx", "test/browser/transport.tsx"]
}
